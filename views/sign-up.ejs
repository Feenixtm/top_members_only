<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/css/output.css">
</head>
<body>
    <h1>Sign Up</h1>

    <form class="flex flex-col max-w-[16rem]" action="/sign-up" method="POST">
        <label for="">First Name</label>
        <input class="border" type="text" name="firstName" placeholder="E.g. John">

        <label for="">Last Name</label>
        <input class="border" type="text" name="lastName" placeholder="E.g. Smith">
        
        <label for="">Username</label>
        <input class="border" type="text" name="username">

        <label for="">Password</label>
        <input class="border" type="password" name="password">

        <button type="submit">Log-in</button>
    </form>

    <p>
        Don't have an account? 
        <a class="w-fit" href="/log-in">Log-in here</a>
    </p>

    <a class="w-fit" href="/">Return to Home</a>
</body>
</html>